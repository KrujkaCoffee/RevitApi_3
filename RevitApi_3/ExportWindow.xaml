<Window x:Class="RevitApi_3.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выгрузка ресурсной в ERP"
        Height="550" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верх -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Title:" VerticalAlignment="Center"/>
                <TextBox x:Name="TitleBox" Width="320" Margin="6,0,0,0"/>
                <TextBlock x:Name="ContextLabel" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <GroupBox Header="Выходное изделие">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Наименование:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OutputNameText" Margin="4,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Код:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OutputCodeText" Margin="4,0,16,0" VerticalAlignment="Center"/>

                    <Button x:Name="BtnPickOutput"
                            Content="🔍 Подобрать / создать"
                            Margin="8,0,0,0"
                            Padding="6,2"
                            Click="BtnPickOutput_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Таблица -->
        <GroupBox Grid.Row="1" Header="Предпросмотр (как в спецификации)">
            <DataGrid x:Name="ExportGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErpCode}" Value="">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErpCode}" Value="-">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>

        <!-- Низ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="BtnExport"
                    Content="📤 Выгрузить в ERP"
                    Width="170" Margin="0,0,8,0"
                    Click="BtnExport_Click"/>
            <Button x:Name="BtnClose"
                    Content="✖ Закрыть"
                    Width="90"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
