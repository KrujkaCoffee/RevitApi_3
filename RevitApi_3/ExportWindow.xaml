<Window x:Class="RevitApi_3.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выгрузка ресурсной в ERP"
        Height="650" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верх -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Наименование ресурсной:" VerticalAlignment="Center"/>
                <TextBox x:Name="TitleBox" Width="520" Margin="6,0,0,0"/>
                <TextBlock x:Name="ContextLabel" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Автор:" VerticalAlignment="Center"/>
                <TextBox IsEnabled="False" x:Name="AuthorBox" Width="240" Margin="6,0,12,0"/>

                <TextBlock Text="Дата начала:" VerticalAlignment="Center"/>
                <DatePicker x:Name="StartDatePicker" Width="140" Margin="6,0,12,0"/>

                <TextBlock Text="Дата конца:" VerticalAlignment="Center"/>
                <DatePicker x:Name="EndDatePicker" Width="140" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="FieldErrorsText"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>


            <GroupBox Header="Выпускаемое изделие">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Наименование:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OutputNameText" Margin="4,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Код:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OutputCodeText" Margin="4,0,16,0" VerticalAlignment="Center"/>

                    <Button x:Name="BtnPickOutput"
                            Content="🔍 Подобрать / создать"
                            Margin="8,0,0,0"
                            Padding="6,2"
                            Click="BtnPickOutput_Click"/>
                </StackPanel>
                
            </GroupBox>
            <TextBlock x:Name="SuccessText" VerticalAlignment="Center"/>
            <TextBlock x:Name="Open1cLinkBlock"
           Margin="8,0,0,0"
           VerticalAlignment="Center"
           Foreground="Blue"
           TextDecorations="Underline"
           Cursor="Hand"
           Visibility="Collapsed"
           MouseLeftButtonUp="Open1cLinkBlock_MouseLeftButtonUp">Открыть в 1С</TextBlock>

        </StackPanel>

        <!-- Таблица -->
        <GroupBox Grid.Row="1" Header="Предпросмотр перед выгрузкой">
            <DataGrid x:Name="ExportGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      HeadersVisibility="All">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErpCode}" Value="">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErpCode}" Value="-">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>

        <!-- Мини-таблица ошибок -->
        <Expander Grid.Row="2"
                  x:Name="ErrorsExpander"
                  Header="Ошибки табличной части"
                  IsExpanded="True"
                  Visibility="Collapsed"
                  Margin="0,8,0,0">
            <DataGrid x:Name="ErrorsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="ErrorsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Строка" Binding="{Binding Row}" Width="90"/>
                    <DataGridTextColumn Header="Ошибка" Binding="{Binding Msg}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- Низ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="BtnCheck"
                    Content="✅ Проверить"
                    Width="120" Margin="0,0,8,0"
                    Click="BtnCheck_Click"/>
            <Button x:Name="BtnExport"
                    Content="📤 Выгрузить в ERP"
                    Width="170" Margin="0,0,8,0"
                    Click="BtnExport_Click"/>
            <Button x:Name="BtnClose"
                    Content="✖ Закрыть"
                    Width="90"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
