<Window x:Class="RevitApi_3.MappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопоставление кодов 1C-ERP"
        Height="600" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- фильтры -->
            <RowDefinition Height="*"/>
            <!-- основная часть -->
            <RowDefinition Height="Auto"/>
            <!-- низ -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Revit -->
            <ColumnDefinition Width="Auto"/>
            <!-- стрелка -->
            <ColumnDefinition Width="*"/>
            <!-- ERP -->
        </Grid.ColumnDefinitions>

        <!-- Фильтры -->
        <CheckBox x:Name="ChkOnlyWithoutCode"
                  Grid.Row="0" Grid.Column="0"
                  Content="Показывать только элементы без кода ERP"
                  Margin="0,0,0,4"
                  Checked="ChkOnlyWithoutCode_Changed"
                  Unchecked="ChkOnlyWithoutCode_Changed"/>

        <!-- Левая таблица: Revit -->
        <GroupBox Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Header="Номенклатуры Revit">
            <DataGrid x:Name="RevitGrid"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Семейство" Binding="{Binding FamilyName}" Width="*"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="*"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding DisplayName}" Width="2*"/>
                    <DataGridTextColumn Header="Код 1C-ERP" Binding="{Binding ErpCode}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErpCode}" Value="">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErpCode}" Value="-">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>

        <!-- Кнопка-стрелка -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="BtnAssignCode"
                    Content="⟵"
                    Width="40" Height="40"
                    ToolTip="Применить выбранный код 1C к выделенным строкам Revit"
                    Click="BtnAssignCode_Click"/>
        </StackPanel>

        <!-- Правая часть: дерево + таблица кодов -->
        <GroupBox Grid.Row="1" Grid.Column="2" Margin="4,0,0,0" Header="Номенклатуры 1C-ERP">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <!-- дерево -->
                    <RowDefinition Height="Auto"/>
                    <!-- строка поиска -->
                    <RowDefinition Height="*"/>
                    <!-- таблица кодов -->
                </Grid.RowDefinitions>

                <!-- Дерево ERP -->
                <TreeView x:Name="ErpTree"
                          Grid.Row="0"
                          SelectedItemChanged="ErpTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Description}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Поиск по кодам -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,4">
                    <TextBlock Text="Поиск по ERP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="ErpSearchBox"
                             Width="220"
                             TextChanged="ErpSearchBox_TextChanged"/>
                </StackPanel>

                <!-- Таблица кодов -->
                <DataGrid x:Name="ErpGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="*"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="Auto" MinWidth="70"/>
                        <DataGridTextColumn Header="Дополнительно" Binding="{Binding Extra}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="BtnCreateNomenclature"
        Content="➕ Создать"
        Width="110" Margin="0,0,8,0"
        Click="BtnCreateNomenclature_Click"/>

            <Button x:Name="BtnAutoMap"
                    Content="🔁 Авто по имени"
                    Width="140" Margin="0,0,8,0"
                    Click="BtnAutoMap_Click"/>
            <Button x:Name="BtnSave"
                    Content="💾 Записать в модель"
                    Width="170" Margin="0,0,8,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnClose"
                    Content="✖ Закрыть"
                    Width="90"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
