<Window x:Class="RevitApi_3.MappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопоставление кодов 1C-ERP"
        Height="600" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="ERP Endpoint:" VerticalAlignment="Center"/>
            <TextBox x:Name="EndpointBox" Width="350" Margin="6,0,0,0"/>
            <TextBlock Text="Document title:" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TitleBox" Width="200" Margin="6,0,0,0"/>
            <Button x:Name="BtnLoadErp" Content="Загрузить из 1C"
                    Margin="12,0,0,0" Padding="6,2"
                    Click="BtnLoadErp_Click"/>
        </StackPanel>

        <!-- Левая таблица: Revit -->
        <GroupBox Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Header="Номенклатуры Revit">
            <DataGrid x:Name="RevitGrid"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Семейство" Binding="{Binding FamilyName}" Width="*"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="*"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding DisplayName}" Width="2*"/>
                    <DataGridTextColumn Header="Код 1C-ERP" Binding="{Binding ErpCode}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Правая таблица: ERP -->
        <GroupBox Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Header="Номенклатуры 1C-ERP">
            <DataGrid x:Name="ErpGrid"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="ErpGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="*"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Дополнительно" Binding="{Binding Extra}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="BtnAutoMap" Content="Авто по имени" Width="120" Margin="0,0,8,0"
                    Click="BtnAutoMap_Click"/>
            <Button x:Name="BtnSave" Content="Записать в модель" Width="150" Margin="0,0,8,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnClose" Content="Закрыть" Width="90"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
