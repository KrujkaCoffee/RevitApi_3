<Window x:Class="RevitApi_3.MappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопоставление кодов 1C-ERP"
        Height="760" Width="1500" MinHeight="560" MinWidth="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="DiagnosticText" Grid.Row="0" Grid.ColumnSpan="3"
                   Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,6">
            <CheckBox x:Name="ChkOnlyWithoutCode" DockPanel.Dock="Left"
                      Content="Только без кода ERP" Margin="0,0,16,0"
                      Checked="RevitFilter_Changed" Unchecked="RevitFilter_Changed"/>
            <TextBlock DockPanel.Dock="Left" Text="Фильтр по спецификации:"
                       VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="RevitSearchBox" MinWidth="220"
                     TextChanged="RevitFilter_Changed"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="4,0,0,6">
            <CheckBox x:Name="ChkGlobalSearch" Content="Глобальный поиск"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      Checked="ChkGlobalSearch_Changed" Unchecked="ChkGlobalSearch_Changed"/>
            <TextBlock Text="Поиск по ERP:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="ErpSearchBox" Width="260"
                     TextChanged="ErpSearchBox_TextChanged"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Grid.Column="0" Margin="0,0,4,0"
                  Header="Строки активной спецификации ">
            <DataGrid x:Name="RevitGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended"
                      SelectionUnit="FullRow" CanUserAddRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      LoadingRow="RevitGrid_LoadingRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               TextAlignment="Center" MaxWidth="260"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding MatchInfo}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMissingErpCode}" Value="True">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanWriteErpCode}" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="BtnAssignCode" Content="⟵" Width="42" Height="42"
                    ToolTip="Назначить выбранный код ERP выделенным строкам"
                    Click="BtnAssignCode_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Grid.Column="2" Margin="4,0,0,0" Header="Номенклатура 1C-ERP">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <TreeView x:Name="ErpTree" Grid.Row="0"
                          SelectedItemChanged="ErpTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Description}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock x:Name="ErpStatusText" Grid.Row="1" Margin="0,5"
                           Foreground="DimGray" TextWrapping="Wrap"/>

                <DataGrid x:Name="ErpGrid" Grid.Row="2" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="Auto" MinWidth="110"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="Auto" MinWidth="75"/>
                        <DataGridTextColumn Header="Дополнительно" Binding="{Binding Extra}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnSave" Content="Записать в модель" Width="165"
                    Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Закрыть" Width="90" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
